<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The API under the hardened runtime (ADR-013 Decision 4). Measured on this build:
  without allow-jit the .NET runtime cannot start ("Failed to create CoreCLR"); without
  disable-library-validation the apphost cannot load the shared .NET runtime, which another
  team signs. DYLD environment variables stay blocked (no allow-dyld-environment-variables).
-->
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
