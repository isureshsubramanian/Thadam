# Allowlist: ignore everything, then allow only publishable source and build files.
# Docs, ADRs, research, probe output, local instruction files and all data stay local.
/*
!/.gitignore
!/LICENSE
!/README.md
!/SECURITY.md
!/.github/
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/clippy.toml
!/deny.toml
!/about.toml
!/about.hbs
!/THIRD-PARTY-NOTICES.txt
!/crates/
!/macos/
!/api/
!/web/
!/scripts/
/scripts/*
!/scripts/gate.sh
!/scripts/icon.sh
!/scripts/install-api.sh
!/scripts/install-collector.sh
!/scripts/install-hooks.sh
!/scripts/migrate-store.sh
!/scripts/notices.mjs
!/scripts/notices.sh
!/scripts/notices-input/
!/scripts/package.sh
!/scripts/package/
!/scripts/preflight.sh
!/scripts/swift-unwrap-check.pl

# Never commit data or build output, even inside allowed folders.
target/
bin/
# Rust binary sources are source, not build output.
!/crates/*/src/bin/
obj/
TestResults/
node_modules/
/web/dist/
/web/dist-packages.json
*.db
*.db-wal
*.db-shm
*.db-journal
*.jsonl
.DS_Store

# Swift and Xcode local state; the signing team stays local.
.build/
.swiftpm/
xcuserdata/
/macos/Config/Local.xcconfig
